DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/dbname

JWT_SECRET=replace-me-with-long-random-string

# Email (Resend) — OPTIONAL.
# Leave RESEND_API_KEY empty to disable email confirmation entirely:
# registration auto-verifies the account and login works immediately.
# Set it to enable email verification + password-reset emails.
RESEND_API_KEY=
# Sender address. Must be on a domain you verified in Resend to deliver to
# arbitrary recipients. The default onboarding@resend.dev only delivers to
# your own Resend account email.
EMAIL_FROM=onboarding@resend.dev


APP_URL=http://localhost:8080

VITE_API_URL=http://localhost:8000

# Only needed for docker-compose.deploy.yml (production):
# POSTGRES_PASSWORD=
# GHCR_REPO=owner/repo
